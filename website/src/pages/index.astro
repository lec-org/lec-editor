---
import Container from '../components/Container.astro';
import Link from '../components/Link.astro';
import Layout from '../layouts/Layout.astro';
import downloads from '../data/downloads.json';

type Download = { name: string; size: number; sha256: string; github: string; gitee: { parts: { name: string; size: number; url: string }[]; command: string | null } };
const release = downloads as { tag: string | null; commit: string | null; files: Download[] };
const files = release.files;
const hasGitee = files.some(file => file.gitee.parts.length > 0);
const platforms = [
  { name: 'macOS', key: 'mac', arch: 'Apple Silicon · ARM64', extension: 'DMG', file: 'line-macos-aarch64.dmg', icon: '⌘' },
  { name: 'Windows', key: 'windows', arch: 'Intel / AMD · x64', extension: 'EXE', file: 'line-windows-x86_64.exe', icon: '⊞' },
  { name: 'Linux', key: 'linux', arch: 'Intel / AMD · x64', extension: 'TAR.GZ', file: 'line-linux-x86_64.tar.gz', icon: '>_' },
];
// 发布清单只接受已校验的公开地址，防止异常清单生成危险链接。
for (const file of files) {
  if (!/^[a-f0-9]{64}$/.test(file.sha256) || !Number.isSafeInteger(file.size) || file.size <= 0) throw new Error('制品清单校验失败');
  for (const [url, host] of [[file.github, 'github.com'], ...file.gitee.parts.map(part => [part.url, 'gitee.com'])]) {
    const parsed = new URL(url);
    if (parsed.protocol !== 'https:' || parsed.hostname !== host || parsed.username || parsed.password || parsed.search) throw new Error('制品下载地址校验失败');
  }
}
const size = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MiB`;
const version = release.tag?.replace('lec-v', '');
const code = [
  '<span class="syntax-purple">#include</span> <span class="syntax-green">&lt;stdio.h&gt;</span>',
  '',
  '<span class="syntax-purple">int</span> <span class="syntax-blue">main</span>(<span class="syntax-purple">void</span>) {',
  '    <span class="syntax-blue">printf</span>(<span class="syntax-green">"Hello, Line!\\n"</span>);',
  '    <span class="syntax-purple">return</span> <span class="syntax-orange">0</span>;',
  '}',
];
const debugCode = ['int main(void) {', '    int value = 1;', '    value += 2;', '    printf("%d\\n", value);', '    return 0;', '}'];
---

<Layout title="Line — 为 C/C++ 初学者而来的轻量编辑器">
  <header class="site-header">
    <Container class="nav">
      <a class="brand glass" href="#" aria-label="Line 首页"><img src={`${import.meta.env.BASE_URL}/line.png`} width="32" height="32" alt=""/><span>Line</span></a>
      <nav class="glass" aria-label="主导航"><a href="#experience">编辑体验</a><a href="#debugging" class="nav-detail">调试</a><a href="https://github.com/lec-org/lec-editor" class="nav-source">GitHub <span aria-hidden="true">↗</span></a><a class="nav-download" href="#downloads"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></svg>下载</a></nav>
    </Container>
  </header>
  <main id="main">
    <div class="hero-shell">
      <div class="hero-atmosphere" aria-hidden="true"><div class="light-ribbon"></div><div class="light-ribbon ribbon-two"></div></div>
      <section class="hero" aria-labelledby="hero-title">
        <Container>
          <div class="hero-copy">
            <a class="release-label" href="https://github.com/lec-org/lec-editor/releases"><span class="status-dot"></span>{version ? `Line ${version} 现已发布` : '为 C / C++ 初学者而来'}<span aria-hidden="true">↗</span></a>
            <h1 id="hero-title">从第一行代码，<br/>到第一个<span class="hero-result">「我会了」。</span></h1>
            <p class="hero-description">为 C / C++ 初学者而来的轻量编辑器。<br/>中文界面，内置编译与调试工具。打开，就能开始。</p>
            <div class="hero-actions"><Link href="#downloads"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></svg>免费下载 Line</Link><a class="button secondary" href="#experience">看看编辑器 <span aria-hidden="true">↘</span></a></div>
            <p class="hero-platforms">macOS <span>·</span> Windows <span>·</span> Linux <span class="platform-note">无需另装编译器</span></p>
          </div>
        <div class="editor-stage" id="experience">
          <div class="editor-halo" aria-hidden="true"></div>
          <div class="editor-window">
            <div class="editor-titlebar"><div class="traffic" aria-hidden="true"><i></i><i></i><i></i></div><div class="window-name"><img src={`${import.meta.env.BASE_URL}/line.png`} width="17" height="17" alt=""/>Line <span>/</span> C语言练习</div><span class="window-badge">C / C++</span></div>
            <div class="editor-main">
              <div class="activity-bar" aria-hidden="true"><span class="activity-active"><svg viewBox="0 0 24 24"><path d="M8 3h7l5 5v12H8zM4 7v14h12M15 3v6h5"/></svg></span><span><svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg></span><span><svg viewBox="0 0 24 24"><path d="M5 5h14M5 10h14M5 15h14M5 20h14"/></svg></span><span><svg viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="13" rx="5"/><path d="M9 7V4h6v3M3 10h4m10 0h4M3 16h4m10 0h4M12 8v12"/></svg></span><span class="activity-bottom"><svg viewBox="0 0 24 24"><path d="M3 3h7v7H3zm11 0h7v7h-7zM3 14h7v7H3zm11 0h7v7h-7z"/></svg></span></div>
              <aside class="editor-sidebar" aria-label="示意文件列表"><div class="sidebar-heading">文件 <span>＋</span></div><div class="project-folder">⌄ <span class="folder-icon">▰</span> C语言练习</div><div class="source-file active"><span class="c-file-icon">C</span><span data-filename>main.c</span></div><div class="source-file muted"><span class="file-outline">◇</span> 学习笔记.txt</div><div class="sidebar-tip"><span class="status-dot"></span>工具链已就绪</div></aside>
              <div class="editor-workspace">
                <div class="editor-toolbar"><div role="tablist" aria-label="选择代码示例"><button type="button" role="tab" id="example-c" aria-controls="code-example" aria-selected="true" tabindex="0" data-language="c">main.c<span class="tab-dot"></span></button><button type="button" role="tab" id="example-cpp" aria-controls="code-example" aria-selected="false" tabindex="-1" data-language="cpp">main.cpp</button></div><button type="button" class="run-button" id="run-demo"><span aria-hidden="true">▶</span><span data-run-label>运行演示</span><kbd>F5</kbd></button></div>
                <div class="code-area" id="code-example" role="tabpanel" aria-labelledby="example-c"><div class="code-breadcrumb"><span data-filename>main.c</span><span>›</span>main()</div><pre id="source-code">{code.map((line, index) => <span class="code-line"><span class="line-number" aria-hidden="true">{index + 1}</span><code set:html={line || ' '} /></span>)}</pre></div>
                <div class="terminal"><div class="terminal-tabs"><span class="terminal-active">运行结果</span><span>终端</span><span class="terminal-right">内置 Zig · C17 / C++17</span></div><div class="terminal-output" aria-live="polite" aria-atomic="true"><p class="terminal-command"><span>❯</span> <span id="terminal-command">编译运行 main.c</span></p><p class="terminal-result" id="terminal-result">Hello, Line!</p><p class="terminal-status" id="terminal-status"><span>✓</span> 程序已结束，退出代码 0</p></div></div>
              </div>
            </div>
            <div class="editor-status"><span><span class="status-dot"></span>就绪 <span class="status-separator">│</span> 0 个错误　0 个警告</span><span>UTF-8 <span class="status-separator">│</span> <span id="status-language">C</span> <span class="status-separator">│</span> 4 空格</span></div>
          </div>
          <div class="editor-caption"><span>交互界面示意 · 可点击「运行演示」</span><span>点击文件标签，切换 C / C++ <span aria-hidden="true">↗</span></span></div>
        </div>
        </Container>
      </section>
    </div>

    <Container>
      <section class="media-section toolchain-section" aria-labelledby="toolchain-title">
        <div class="setup-window feature-surface reveal">
          <div class="mini-title"><img src={`${import.meta.env.BASE_URL}/line.png`} width="24" height="24" alt=""/>开始你的第一次练习<span class="ready-badge"><span class="status-dot"></span>准备就绪</span></div>
          <div class="setup-folder"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h7l2 3h9v11H3z"/></svg><span>C语言练习</span><span class="folder-empty">空文件夹</span></div>
          <div class="creation-actions"><span>从一份源文件开始</span><a href="#experience"><span class="file-token">C</span>创建 C 文件 <span aria-hidden="true">＋</span></a><div class="creation-divider"><span>或</span></div><a href="#experience"><span class="file-token cpp-token">C++</span>创建 CPP 文件 <span aria-hidden="true">＋</span></a></div>
          <div class="setup-checks"><span><i>✓</i>C / C++ 编译工具</span><span><i>✓</i>调试器</span><span><i>✓</i>中文界面</span></div>
          <p class="visual-note">界面示意 · 下载后即可在编辑器中创建</p>
        </div>
        <div class="media-copy reveal"><span class="eyebrow">开始，简单一点</span><h2 id="toolchain-title">第一课是写代码，<br/>环境已经准备好了。</h2><p>不必先找编译器、配路径。Line 在三个系统上都内置 Zig C/C++ 工具链，从空文件夹创建一份 C 或 C++ 文件，就能开始练习。</p><a class="button secondary" href="#downloads">选择你的系统 <span aria-hidden="true">↗</span></a><div class="feature-tags"><span>C17</span><span>C++17</span><span>无需配置 PATH</span></div></div>
      </section>

      <section id="debugging" class="media-section debug-section" aria-labelledby="debug-title">
        <div class="media-copy reveal"><span class="eyebrow">看懂每一步</span><h2 id="debug-title">程序怎么运行，<br/>停下来就看明白了。</h2><p>结果和想的不一样？设一个断点，单步执行，观察变量。运行和基础调试都在手边，不必先写配置文件。</p><div class="debug-shortcuts"><span><kbd>F6</kbd> 开始调试</span><span><kbd>F9</kbd> 切换断点</span></div><button type="button" class="button secondary" id="debug-next">下一步演示 <span aria-hidden="true">→</span></button><p class="demo-note">交互示意：点击按钮，观察 value 从 1 变为 3。</p></div>
        <div class="debug-window feature-surface reveal"><div class="debug-window-top"><span class="status-dot"></span><span id="debug-state">已在断点暂停</span><span class="debug-file">main.c</span></div><div class="debug-content"><div class="debug-code">{debugCode.map((line, index) => <div class:list={['debug-code-line', index === 2 && 'current-line']} data-debug-line={index}><span class="debug-gutter">{index === 2 ? '●' : ''}</span><span class="line-number">{index + 1}</span><code>{line}</code><span class="execution-arrow" aria-hidden="true">←</span></div>)}</div><div class="debug-variables"><span class="variable-heading">局部变量 <span>⌄</span></span><div class="variable-row"><span class="variable-type">int</span><span>value</span><strong id="debug-value" aria-live="polite">1</strong></div><div class="variable-hint"><span class="status-dot"></span><span id="debug-hint">执行下一行，看看值的变化。</span></div></div></div><div class="debug-window-footer"><span>内置 CodeLLDB</span><span>不必先编写调试配置</span></div></div>
      </section>

      <section class="workflow-section" aria-labelledby="workflow-title"><div class="workflow-heading reveal"><span class="eyebrow">学编程，少一点阻碍</span><h2 id="workflow-title">写代码需要的，<br/>就在你熟悉的位置。</h2></div><div class="workflow-steps"><article class="reveal"><span class="step-index">01 / 编写</span><h3>用中文，找到下一步</h3><p>文件操作、常用菜单与运行入口使用中文。保留语法高亮、代码补全与问题提示，让注意力回到代码。</p></article><article class="reveal"><span class="step-index">02 / 运行</span><h3>按 F5，看见结果</h3><p>在底部终端查看输出、输入数据。编译失败时不会运行旧产物，当前源文件和运行结果对应得上。</p></article><article class="reveal"><span class="step-index">03 / 专注</span><h3>工具，恰好够用</h3><p>无需登录，打开即可使用。编辑、搜索、终端和基础调试，加上主题与图标扩展，按自己的节奏学习。</p></article></div></section>

      <section class="open-source reveal" aria-labelledby="open-title"><div class="source-symbol" aria-hidden="true">{ '</>' }</div><h2 id="open-title">原生的底子，开源的自由。</h2><p>Line fork 自 Zed，用 Rust 与 GPUI 构建。<br/>保留扎实的编辑器核心，为 C / C++ 入门精简体验。<br/>每一处改动，都可以在源码里看到。</p><div class="center-actions"><a class="button" href="https://github.com/lec-org/lec-editor">查看源代码 <span aria-hidden="true">↗</span></a><a class="button secondary" href="https://github.com/lec-org/lec-editor#使用说明">阅读使用说明 <span aria-hidden="true">↗</span></a></div><div class="cli-strip"><span>习惯终端？用命令打开项目。</span><button type="button" id="copy-cli" aria-label="复制 line 点命令"><code><span>❯</span> line .</code><span class="copy-label">复制 ⧉</span></button><span id="copy-status" class="sr-only" aria-live="polite"></span></div></section>

      <section id="downloads" class="downloads" aria-labelledby="download-title"><div class="download-heading reveal"><img class="download-icon" src={`${import.meta.env.BASE_URL}/line.png`} width="88" height="88" alt="" loading="lazy"/><h2 id="download-title">写下你的第一行。</h2><p>选好系统，下载 Line。<br/>编译器和调试器，一起准备好了。</p><span class="version-label">{version ? `v${version} · 免费开源` : '安装包正在构建'}</span></div>
        <div class="platform-grid">{platforms.map(platform => {
          const file = files.find(file => file.name === platform.file);
          return <article class="platform feature-surface reveal" data-platform={platform.key}><div class="platform-icon" aria-hidden="true">{platform.icon}</div><h3>{platform.name}</h3><p>{platform.arch}</p>{file ? <><Link href={file.github} data-download={platform.key}>下载 {platform.extension}<span aria-hidden="true">↓</span></Link><span class="file-size">{size(file.size)} <span>· 内置 C/C++ 工具链</span></span>{file.gitee.parts.length > 0 && <details class="gitee-download"><summary>从 Gitee 下载</summary><div class="gitee-parts">{file.gitee.parts.map((part, index) => <a href={part.url}>{file.gitee.parts.length > 1 ? `下载分卷 ${index + 1} / ${file.gitee.parts.length}` : '下载安装包'} <span>↓</span></a>)}{file.gitee.command && <><p>下载全部分卷后，在下载目录执行：</p><pre>{file.gitee.command}</pre></>}</div></details>}<details class="checksum"><summary>SHA-256 校验值</summary><code>{file.sha256}</code></details></> : <div class="awaiting"><span>安装包构建中</span><a href="https://github.com/lec-org/lec-editor/releases">查看发行记录 ↗</a></div>}</article>;
        })}</div>
        <p class="download-notice">macOS 安装包未经 Apple 公证，Windows 安装包尚未签名。更新请回到本页下载。</p><div class="release-links"><a href="https://github.com/lec-org/lec-editor/releases">查看发行记录 <span aria-hidden="true">↗</span></a>{hasGitee && <a href="https://gitee.com/lec-org/lec-editor/releases">Gitee 发行记录 ↗</a>}{release.commit && <a href={`https://github.com/lec-org/lec-editor/tree/${release.commit}`}>本版本源码 <span aria-hidden="true">↗</span></a>}</div>
      </section>

      <section class="faq-section reveal" aria-labelledby="faq-title"><h2 id="faq-title">你可能还想知道。</h2><div class="faq-list"><details><summary>还需要自己安装编译器吗？<span aria-hidden="true">＋</span></summary><p>正式安装包已经附带 Zig C/C++ 工具链和 CodeLLDB 调试器，无需额外安装编译器或手动配置系统 PATH。从源码构建则需要按仓库说明准备工具。</p></details><details><summary>C 和 C++ 都可以写吗？<span aria-hidden="true">＋</span></summary><p>可以。保存为 .c 时使用 C17，保存为 .cpp、.cc、.cxx 时使用 C++17。当前快捷运行入口编译单个源文件，适合入门阶段的独立练习。</p></details><details><summary>Line 和 Zed 是什么关系？<span aria-hidden="true">＋</span></summary><p>Line fork 自 Zed，当前固定基于 Zed v1.28.1，沿用 Rust 与 GPUI 的原生编辑基础，再为 C/C++ 初学者精简功能、补充中文界面与编译运行体验。Line 保留上游版权声明和开源许可证。</p></details><details><summary>在 Mac 上按 F5 没有反应？<span aria-hidden="true">＋</span></summary><p>部分 Mac 键盘需要按 Fn + F5，也可以直接点击编辑器右上角的「运行」按钮。调试对应 F6，断点对应 F9。</p></details></div></section>
    </Container>
  </main>
  <footer class="site-footer"><Container><div class="footer-top"><div class="footer-brand"><a class="brand" href="#" aria-label="返回顶部"><img src={`${import.meta.env.BASE_URL}/line.png`} width="36" height="36" alt=""/><span>Line</span></a><p>让第一行代码，更容易开始。</p></div><nav aria-label="页脚"><div><span>Line</span><a href="#downloads">下载</a><a href="#experience">编辑体验</a><a href="#debugging">基础调试</a></div><div><span>资源</span><a href="https://github.com/lec-org/lec-editor#使用说明">使用说明</a><a href="https://github.com/lec-org/lec-editor/releases">版本发布</a><a href="https://github.com/lec-org/lec-editor/issues">反馈问题</a></div><div><span>开源</span><a href="https://github.com/lec-org/lec-editor">GitHub ↗</a><a href="https://github.com/zed-industries/zed">上游 Zed ↗</a><a href="https://github.com/lec-org/lec-editor/blob/main/LICENSE-GPL">GPL-3.0</a></div></nav></div><div class="footer-bottom"><p>Powered by <strong>乐程软件工作室</strong></p><span>基于 Zed · 为初学者而来</span><a href="#">回到顶部 ↑</a></div></Container></footer>
</Layout>
<script>
  import '../scripts/site';
</script>
